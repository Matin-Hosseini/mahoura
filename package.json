{
  "name": "mahoura-party",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e:api": "pnpm --filter api test:e2e",
    "verify": "pnpm format:check && pnpm lint && pnpm check-types && pnpm test && pnpm test:e2e:api && pnpm build",
    "prepare": "husky",
    "snapshot": "node scripts/snapshot.mjs",
    "docker:env": "node scripts/init-docker-env.mjs",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "party:smoke": "node scripts/party-smoke.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "archiver": "^8.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "3.9.6",
    "turbo": "^2.11.13",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.29.0",
  "engines": {
    "node": ">=24"
  }
}
